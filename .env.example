# =============================================================
#   MENÚ DIGITAL v2.0 — CONFIGURACIÓN DE EJEMPLO
#   Copia este archivo como .env y llena tus valores reales.
#   NUNCA subas .env a GitHub.
# =============================================================

# Puerto externo del servidor
PORT=8070

# Credenciales del panel de administración
ADMIN_USER=admin
ADMIN_PASSWORD=tu_contraseña_segura

# Clave secreta para cifrar las sesiones (genera una: openssl rand -hex 32)
SESSION_SECRET=genera_una_clave_aleatoria_muy_larga_aqui
