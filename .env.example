# =============================================================
#   MENÚ DIGITAL — CONFIGURACIÓN DE ENTORNO
#   Copia este archivo como  .env  y llena tus valores reales.
#   NUNCA subas .env a GitHub.
# =============================================================

# ─────────────────────────────────────────────────────────────
#  PUERTO EXTERNO
#  En qué puerto de tu servidor escuchará el menú.
#  Ejemplos válidos: 80, 8080, 3000, 8888, 9000
# ─────────────────────────────────────────────────────────────
PORT=8080

# ─────────────────────────────────────────────────────────────
#  CREDENCIALES DEL PANEL DE ADMINISTRACIÓN
#  Solo quien tenga estas credenciales puede entrar a /admin.html
# ─────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contraseña
